<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.vpnguard</string>

    <key>ProgramArguments</key>
    <array>
        <string>__VPNGUARD_BIN__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Re-evaluate on network changes. resolv.conf is rewritten on most net
         transitions; preferences.plist covers SSID/profile changes. -->
    <key>WatchPaths</key>
    <array>
        <string>/etc/resolv.conf</string>
        <string>/Library/Preferences/SystemConfiguration/preferences.plist</string>
        <string>/Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist</string>
    </array>

    <!-- Belt-and-suspenders poll in case a watch event is missed -->
    <key>StartInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/vpn-guard.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vpn-guard.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
