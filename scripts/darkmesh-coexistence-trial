#!/bin/bash
# Compatibility wrapper for the staged experiment suite.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
EXPERIMENT="${DARKMESH_EXPERIMENT:-$SELF_DIR/darkmesh-experiment}"

cat >&2 <<'EOF'
NOTICE: coexistence-trial is now a compatibility wrapper.
Use `darkmesh experiment plan`, `preflight`, and `run --profile staged`.
The old single-case flags are intentionally rejected because they cannot
guarantee the staged suite's exact-state restoration.
EOF

if (($#)); then
  case "$1" in
    -h|--help) exec "$EXPERIMENT" --help ;;
    *) printf 'ERROR: legacy coexistence-trial flags are retired; use the staged profile\n' >&2; exit 2 ;;
  esac
fi
exec "$EXPERIMENT" run --profile staged
